{
  "name": "tokenring-one-docker-build",
  "private": true,
  "description": "Docker packaging for TokenRing One",
  "scripts": {
    "build:full": "docker build --target full -t tokenring-ai/one:full -f Dockerfile .",
    "build:server": "docker build --target server -t tokenring-ai/one:server -f Dockerfile .",
    "build:cli": "docker build --target cli -t tokenring-ai/one:cli -f Dockerfile .",
    "build": "bun run build:full && bun run build:server && bun run build:cli"
  }
}
