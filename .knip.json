{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "util/**",
    "packaging/**",
    "docs/**",
    "website/**"
  ],
  "entry": [],
  "ignoreDependencies": [
    "@tokenring-ai/one-frontend",
    "react",
    "react-router-dom",
    "lucide-react",
    "@monaco-editor/react",
    "swr",
    "react-markdown",
    "remark-gfm",
    "focus-trap-react",
    "@dnd-kit/core",
    "@dnd-kit/sortable",
    "@dnd-kit/utilities",
    "@blocknote/ariakit",
    "@blocknote/core",
    "@blocknote/react",
    "@testing-library/react",
    "@testing-library/user-event"
  ],
  "exclude": [
    "unresolved",
    "exports"
  ],
  "ignoreExportsUsedInFile": {
    "type": true,
    "interface": true
  },
  "workspaces": {
    "plugin/vault": {
      "entry": [
        "vault-launcher.js"
      ]
    },
    "registry/community": {
      "entry": [
        "scripts/generate-index.ts"
      ]
    }
  }
}
