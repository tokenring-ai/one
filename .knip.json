{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "util/**",
    ".tokenring/*",
    "packaging/**",
    "docs/**"
  ],
  "exclude": [
    "dependencies",
    "unlisted",
    "unresolved",
    "exports"
  ],
  "ignoreExportsUsedInFile": {
    "type": true,
    "interface": true
  }
}