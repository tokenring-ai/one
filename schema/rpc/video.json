{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Generation RPC",
  "description": "JSON-RPC 2.0 messages for /rpc/video-generation",
  "anyOf": [
    {
      "$ref": "#/$defs/JSONRPCError"
    },
    {
      "title": "generateVideo request",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "method": {
          "const": "/rpc/video-generation.generateVideo"
        },
        "params": {
          "$ref": "#/$defs/generateVideoParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "title": "generateVideo response",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "result": {
          "$ref": "#/$defs/generateVideoResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "JSONRPCError": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "number",
            "null"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "number"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false
    },
    "generateVideoParams": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "request": {
          "type": "object",
          "properties": {
            "duration": {
              "type": "number"
            },
            "fps": {
              "type": "number"
            },
            "seed": {
              "type": "number"
            },
            "n": {
              "type": "number"
            },
            "providerOptions": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            },
            "prompt": {
              "type": "string",
              "description": "Description of the video to generate"
            },
            "sizing": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "method": {
                      "type": "string",
                      "const": "direct"
                    },
                    "aspectRatio": {
                      "type": "object",
                      "properties": {
                        "width": {
                          "type": "number"
                        },
                        "height": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "width",
                        "height"
                      ]
                    },
                    "resolution": {
                      "type": "object",
                      "properties": {
                        "width": {
                          "type": "number"
                        },
                        "height": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "width",
                        "height"
                      ]
                    }
                  },
                  "required": [
                    "method"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "method": {
                      "type": "string",
                      "const": "guided"
                    },
                    "quality": {
                      "type": "string",
                      "enum": [
                        "ultra",
                        "high",
                        "standard",
                        "low"
                      ],
                      "description": "Quality of the generated video"
                    },
                    "shape": {
                      "type": "string",
                      "enum": [
                        "square",
                        "landscape",
                        "portrait",
                        "ultrawide",
                        "ultratall"
                      ],
                      "description": "Shape of the generated video"
                    }
                  },
                  "required": [
                    "method",
                    "quality",
                    "shape"
                  ]
                }
              ]
            },
            "keywords": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Keywords to add to media library metadata"
            }
          },
          "required": [
            "prompt",
            "sizing"
          ]
        }
      },
      "required": [
        "agentId",
        "request"
      ],
      "$defs": {
        "__schema0": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              }
            }
          ]
        }
      }
    },
    "generateVideoResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "success"
            },
            "filename": {
              "type": "string"
            },
            "mimeType": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "duration": {
              "type": "number"
            }
          },
          "required": [
            "status",
            "filename",
            "mimeType",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "agentNotFound"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "x-tokenring-rpc": {
    "name": "Video Generation RPC",
    "path": "/rpc/video-generation",
    "source": "plugin/video/rpc/schema.ts",
    "methods": {
      "generateVideo": {
        "type": "mutation",
        "params": "#/$defs/generateVideoParams",
        "result": "#/$defs/generateVideoResult"
      }
    }
  }
}
