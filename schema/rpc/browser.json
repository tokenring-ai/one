  "x-tokenring-rpc": {
    "name": "Browser RPC",
    "path": "/rpc/browser",
    "source": "plugin/browser/rpc/schema.ts",
    "methods": {
      "listSessions": {
        "type": "query",
        "params": "#/$defs/listSessionsParams",
        "result": "#/$defs/listSessionsResult"
      },
      "streamSessions": {
        "type": "stream",
        "params": "#/$defs/streamSessionsParams",
        "result": "#/$defs/streamSessionsResult"
      },
      "getScreenshot": {
        "type": "query",
        "params": "#/$defs/getScreenshotParams",
        "result": "#/$defs/getScreenshotResult"
      },
      "closeTab": {
        "type": "mutation",
        "params": "#/$defs/closeTabParams",
        "result": "#/$defs/closeTabResult"
      },
      "closeSession": {
        "type": "mutation",
        "params": "#/$defs/closeSessionParams",
        "result": "#/$defs/closeSessionResult"
      }
    }
