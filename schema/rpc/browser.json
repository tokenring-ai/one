              "signedIn": {
                "type": "boolean"
              },
              "lastUsedAt": {
                "type": "number"
              },
              "idleTimeout": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "agents": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
