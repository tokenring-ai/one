{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vault RPC",
  "description": "JSON-RPC 2.0 messages for /rpc/vault",
  "anyOf": [
    {
      "$ref": "#/$defs/JSONRPCError"
    },
    {
      "title": "listEntries request",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "method": {
          "const": "/rpc/vault.listEntries"
        },
        "params": {
          "$ref": "#/$defs/listEntriesParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "title": "listEntries response",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "result": {
          "$ref": "#/$defs/listEntriesResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "title": "streamEntries request",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "method": {
          "const": "/rpc/vault.streamEntries"
        },
        "params": {
          "$ref": "#/$defs/streamEntriesParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "title": "streamEntries response",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "result": {
          "$ref": "#/$defs/streamEntriesResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "title": "streamEntries stream end response",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "result": {
          "type": "null"
        },
        "stream": {
          "const": "end"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result",
        "stream"
      ],
      "additionalProperties": false
    },
    {
      "title": "setItems request",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "method": {
          "const": "/rpc/vault.setItems"
        },
        "params": {
          "$ref": "#/$defs/setItemsParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "title": "setItems response",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "result": {
          "$ref": "#/$defs/setItemsResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "title": "deleteItems request",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "method": {
          "const": "/rpc/vault.deleteItems"
        },
        "params": {
          "$ref": "#/$defs/deleteItemsParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "title": "deleteItems response",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "result": {
          "$ref": "#/$defs/deleteItemsResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "JSONRPCError": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "number",
            "null"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "number"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false
    },
    "listEntriesParams": {
      "type": "object",
      "properties": {}
    },
    "listEntriesResult": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "streamEntriesParams": {
      "type": "object",
      "properties": {}
    },
    "streamEntriesResult": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "setItemsParams": {
      "type": "object",
      "properties": {
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "category",
              "key",
              "value"
            ]
          }
        }
      },
      "required": [
        "updates"
      ]
    },
    "setItemsResult": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "message"
      ],
      "additionalProperties": false
    },
    "deleteItemsParams": {
      "type": "object",
      "properties": {
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "category",
              "key"
            ]
          }
        }
      },
      "required": [
        "updates"
      ]
    },
    "deleteItemsResult": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "x-tokenring-rpc": {
    "name": "Vault RPC",
    "path": "/rpc/vault",
    "source": "plugin/vault/rpc/schema.ts",
    "methods": {
      "listEntries": {
        "type": "query",
        "params": "#/$defs/listEntriesParams",
        "result": "#/$defs/listEntriesResult"
      },
      "streamEntries": {
        "type": "stream",
        "params": "#/$defs/streamEntriesParams",
        "result": "#/$defs/streamEntriesResult"
      },
      "setItems": {
        "type": "mutation",
        "params": "#/$defs/setItemsParams",
        "result": "#/$defs/setItemsResult"
      },
      "deleteItems": {
        "type": "mutation",
        "params": "#/$defs/deleteItemsParams",
        "result": "#/$defs/deleteItemsResult"
      }
    }
  }
}
