{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audio RPC",
  "description": "JSON-RPC 2.0 messages for /rpc/audio",
  "anyOf": [
    {
      "$ref": "#/$defs/JSONRPCError"
    },
    {
      "title": "generateSpeech request",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "method": {
          "const": "/rpc/audio.generateSpeech"
        },
        "params": {
          "$ref": "#/$defs/generateSpeechParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "title": "generateSpeech response",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "result": {
          "$ref": "#/$defs/generateSpeechResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "title": "transcribeAudio request",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "method": {
          "const": "/rpc/audio.transcribeAudio"
        },
        "params": {
          "$ref": "#/$defs/transcribeAudioParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "title": "transcribeAudio response",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "result": {
          "$ref": "#/$defs/transcribeAudioResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "JSONRPCError": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "number",
            "null"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "number"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false
    },
    "generateSpeechParams": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "model": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "agentId",
        "text"
      ]
    },
    "generateSpeechResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "success"
            },
            "filename": {
              "type": "string"
            },
            "mimeType": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "filename",
            "mimeType",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "agentNotFound"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        }
      ]
    },
    "transcribeAudioParams": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      },
      "required": [
        "agentId",
        "filename"
      ]
    },
    "transcribeAudioResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "success"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "agentNotFound"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "x-tokenring-rpc": {
    "name": "Audio RPC",
    "path": "/rpc/audio",
    "source": "plugin/audio/rpc/schema.ts",
    "methods": {
      "generateSpeech": {
        "type": "mutation",
        "params": "#/$defs/generateSpeechParams",
        "result": "#/$defs/generateSpeechResult"
      },
      "transcribeAudio": {
        "type": "mutation",
        "params": "#/$defs/transcribeAudioParams",
        "result": "#/$defs/transcribeAudioResult"
      }
    }
  }
}
