  "$defs": {
    "JSONRPCError": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "number",
            "null"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "number"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false
    },
    "streamQueuesParams": {
      "type": "object",
      "properties": {}
    },
    "streamQueuesResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "success"
        },
        "queues": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "config": {
                "type": "object",
                "properties": {
                  "agentType": {
                    "type": "string"
                  },
                  "concurrency": {
                    "type": "number"
                  },
                  "maxSize": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "maxResults": {
                    "type": "number"
                  }
                },
                "required": [
                  "agentType",
                  "concurrency",
                  "maxSize",
                  "maxResults"
                ],
                "additionalProperties": false
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "queueName": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "input": {
                      "type": "string"
                    },
                    "from": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "number"
                    },
                    "startedAt": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "agentId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "requestId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "running"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "queueName",
                    "name",
                    "input",
                    "from",
                    "createdAt",
                    "status"
                  ],
                  "additionalProperties": false
                }
              },
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "queueName": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "input": {
                      "type": "string"
                    },
                    "from": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "number"
                    },
                    "startedAt": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "agentId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "requestId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "completed",
                        "failed",
                        "cancelled"
                      ]
                    },
                    "completedAt": {
                      "type": "number"
                    },
                    "durationMs": {
                      "type": "number"
                    },
                    "resultMessage": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "queueName",
                    "name",
                    "input",
                    "from",
                    "createdAt",
                    "status",
                    "completedAt",
                    "durationMs",
                    "resultMessage"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "config",
              "items",
              "results"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "queues"
      ],
      "additionalProperties": false
    },
    "enqueueParams": {
      "type": "object",
      "properties": {
        "queueName": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "from": {
          "type": "string"
        }
      },
      "required": [
        "queueName",
        "name",
        "input"
      ]
    },
    "enqueueResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "success"
            },
            "itemId": {
              "type": "string"
            },
            "position": {
              "type": "number"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "itemId",
            "position",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "queueNotFound"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        }
      ]
    },
    "cancelItemParams": {
      "type": "object",
      "properties": {
        "queueName": {
          "type": "string"
        },
        "itemId": {
          "type": "string"
        }
      },
      "required": [
        "queueName",
        "itemId"
      ]
    },
    "cancelItemResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "success"
        },
        "cancelled": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "cancelled",
        "message"
      ],
      "additionalProperties": false
    },
    "clearParams": {
      "type": "object",
      "properties": {
        "queueName": {
          "type": "string"
        }
      },
      "required": [
        "queueName"
      ]
    },
    "clearResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "success"
            },
            "removed": {
              "type": "number"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "removed",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "queueNotFound"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        }
      ]
    },
    "createQueueParams": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "agentType": {
          "type": "string"
        },
        "concurrency": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxSize": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "maxResults": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "name",
        "agentType"
      ]
    },
    "createQueueResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "success"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "queueExists"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "invalidAgentType"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "x-tokenring-rpc": {
    "name": "Queue RPC",
    "path": "/rpc/queue",
    "source": "plugin/queue/rpc/schema.ts",
    "methods": {
      "streamQueues": {
        "type": "stream",
        "params": "#/$defs/streamQueuesParams",
        "result": "#/$defs/streamQueuesResult"
      },
      "enqueue": {
        "type": "mutation",
        "params": "#/$defs/enqueueParams",
        "result": "#/$defs/enqueueResult"
      },
      "cancelItem": {
        "type": "mutation",
        "params": "#/$defs/cancelItemParams",
        "result": "#/$defs/cancelItemResult"
      },
      "clear": {
        "type": "mutation",
        "params": "#/$defs/clearParams",
        "result": "#/$defs/clearResult"
      },
      "createQueue": {
        "type": "mutation",
        "params": "#/$defs/createQueueParams",
        "result": "#/$defs/createQueueResult"
      }
    }
  }
}
