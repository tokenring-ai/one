{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bot RPC",
  "description": "JSON-RPC 2.0 messages for /rpc/bot",
  "anyOf": [
    {
      "$ref": "#/$defs/JSONRPCError"
    },
    {
      "title": "listBots request",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "method": {
          "const": "/rpc/bot.listBots"
        },
        "params": {
          "$ref": "#/$defs/listBotsParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "title": "listBots response",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "result": {
          "$ref": "#/$defs/listBotsResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "title": "sendMessage request",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "method": {
          "const": "/rpc/bot.sendMessage"
        },
        "params": {
          "$ref": "#/$defs/sendMessageParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "title": "sendMessage response",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "result": {
          "$ref": "#/$defs/sendMessageResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "title": "resetConversation request",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "method": {
          "const": "/rpc/bot.resetConversation"
        },
        "params": {
          "$ref": "#/$defs/resetConversationParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "title": "resetConversation response",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "result": {
          "$ref": "#/$defs/resetConversationResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "JSONRPCError": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "number",
            "null"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "number"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false
    },
    "listBotsParams": {
      "type": "object",
      "properties": {}
    },
    "listBotsResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "success"
        },
        "bots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "agentType": {
                "type": "string"
              },
              "directMessages": {
                "type": "string",
                "enum": [
                  "listed",
                  "anyone",
                  "none"
                ]
              },
              "requireMention": {
                "type": "boolean"
              },
              "joinMessage": {
                "type": "string"
              },
              "users": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    },
                    "userId": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "admin",
                        "user"
                      ]
                    }
                  },
                  "required": [
                    "target",
                    "service",
                    "userId",
                    "role"
                  ],
                  "additionalProperties": false
                }
              },
              "channels": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "target": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    },
                    "channelId": {
                      "type": "string"
                    },
                    "agentType": {
                      "type": "string"
                    },
                    "allowedUsers": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "connected": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name",
                    "target",
                    "service",
                    "channelId",
                    "agentType",
                    "allowedUsers",
                    "connected"
                  ],
                  "additionalProperties": false
                }
              },
              "conversations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    },
                    "conversationId": {
                      "type": "string"
                    },
                    "agentId": {
                      "type": "string"
                    },
                    "agentType": {
                      "type": "string"
                    },
                    "channelName": {
                      "type": "string"
                    },
                    "startedAt": {
                      "type": "number"
                    },
                    "lastActivityAt": {
                      "type": "number"
                    },
                    "busy": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "key",
                    "service",
                    "conversationId",
                    "agentId",
                    "agentType",
                    "startedAt",
                    "lastActivityAt",
                    "busy"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "displayName",
              "agentType",
              "directMessages",
              "requireMention",
              "users",
              "channels",
              "conversations"
            ],
            "additionalProperties": false
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "maxMessageLength": {
                "type": "number"
              }
            },
            "required": [
              "name",
              "maxMessageLength"
            ],
            "additionalProperties": false
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "members"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "bots",
        "services",
        "groups"
      ],
      "additionalProperties": false
    },
    "sendMessageParams": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "target",
        "message"
      ]
    },
    "sendMessageResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "success"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "providerNotFound"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        }
      ]
    },
    "resetConversationParams": {
      "type": "object",
      "properties": {
        "bot": {
          "type": "string",
          "minLength": 1
        },
        "conversationKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bot",
        "conversationKey"
      ]
    },
    "resetConversationResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "success"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "botNotFound"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "conversationNotFound"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "x-tokenring-rpc": {
    "name": "Bot RPC",
    "path": "/rpc/bot",
    "source": "plugin/bot/rpc/schema.ts",
    "methods": {
      "listBots": {
        "type": "query",
        "params": "#/$defs/listBotsParams",
        "result": "#/$defs/listBotsResult"
      },
      "sendMessage": {
        "type": "mutation",
        "params": "#/$defs/sendMessageParams",
        "result": "#/$defs/sendMessageResult"
      },
      "resetConversation": {
        "type": "mutation",
        "params": "#/$defs/resetConversationParams",
        "result": "#/$defs/resetConversationResult"
      }
    }
  }
}
