  "$defs": {
    "JSONRPCError": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "number",
            "null"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "number"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false
    },
    "listMountsParams": {
      "type": "object",
      "properties": {}
    },
    "listMountsResult": {
      "type": "object",
      "properties": {
        "stores": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scheme": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "scheme",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scheme": {
                "type": "string"
              },
              "authority": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "writable": {
                "type": "boolean"
              },
              "contextualSearch": {
                "type": "boolean"
              }
            },
            "required": [
              "scheme",
              "authority",
              "url",
              "label",
              "writable",
              "contextualSearch"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "stores",
        "mounts"
      ],
      "additionalProperties": false
    },
    "listParams": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ]
    },
    "listResult": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "file",
                  "folder"
                ]
              },
              "mimeType": {
                "type": "string"
              },
              "size": {
                "type": "number"
              },
              "modified": {
                "type": "string"
              },
              "webUrl": {
                "type": "string"
              },
              "readsAs": {
                "type": "string"
              }
            },
            "required": [
              "url",
              "name",
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [
        "entries"
      ],
      "additionalProperties": false
    },
    "statParams": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ]
    },
    "statResult": {
      "type": "object",
      "properties": {
        "entry": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "file",
                    "folder"
                  ]
                },
                "mimeType": {
                  "type": "string"
                },
                "size": {
                  "type": "number"
                },
                "modified": {
                  "type": "string"
                },
                "webUrl": {
                  "type": "string"
                },
                "readsAs": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "name",
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "entry"
      ],
      "additionalProperties": false
    },
    "readParams": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ]
    },
    "readResult": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "size": {
          "type": "number"
        },
        "encoding": {
          "type": "string",
          "enum": [
            "utf8",
            "base64"
          ]
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "mimeType",
        "size",
        "encoding",
        "content"
      ],
      "additionalProperties": false
    },
    "searchParams": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "within": {
          "type": "string"
        },
        "limit": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "query"
      ]
    },
    "searchResult": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "file",
                  "folder"
                ]
              },
              "mimeType": {
                "type": "string"
              },
              "size": {
                "type": "number"
              },
              "modified": {
                "type": "string"
              },
              "webUrl": {
                "type": "string"
              },
              "readsAs": {
                "type": "string"
              }
            },
            "required": [
              "url",
              "name",
              "kind"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "entries"
      ],
      "additionalProperties": false
    },
    "copyToHostParams": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "overwrite": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "url",
        "path"
      ]
    },
    "copyToHostResult": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "size": {
          "type": "number"
        }
      },
      "required": [
        "path",
        "size"
      ],
      "additionalProperties": false
    }
  },
  "x-tokenring-rpc": {
    "name": "Remote Store RPC",
    "path": "/rpc/remote",
    "source": "plugin/filesystem/rpc/remote.schema.ts",
    "methods": {
      "listMounts": {
        "type": "query",
        "params": "#/$defs/listMountsParams",
        "result": "#/$defs/listMountsResult"
      },
      "list": {
        "type": "query",
        "params": "#/$defs/listParams",
        "result": "#/$defs/listResult"
      },
      "stat": {
        "type": "query",
        "params": "#/$defs/statParams",
        "result": "#/$defs/statResult"
      },
      "read": {
        "type": "query",
        "params": "#/$defs/readParams",
        "result": "#/$defs/readResult"
      },
      "search": {
        "type": "query",
        "params": "#/$defs/searchParams",
        "result": "#/$defs/searchResult"
      },
      "copyToHost": {
        "type": "mutation",
        "params": "#/$defs/copyToHostParams",
        "result": "#/$defs/copyToHostResult"
      }
    }
  }
}
