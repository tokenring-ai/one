{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X RPC",
  "description": "JSON-RPC 2.0 messages for /rpc/x",
  "anyOf": [
    {
      "$ref": "#/$defs/JSONRPCError"
    },
    {
      "title": "listAccounts request",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "method": {
          "const": "/rpc/x.listAccounts"
        },
        "params": {
          "$ref": "#/$defs/listAccountsParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "title": "listAccounts response",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "result": {
          "$ref": "#/$defs/listAccountsResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "title": "createPost request",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "method": {
          "const": "/rpc/x.createPost"
        },
        "params": {
          "$ref": "#/$defs/createPostParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "title": "createPost response",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "result": {
          "$ref": "#/$defs/createPostResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "JSONRPCError": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "number",
            "null"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "number"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false
    },
    "listAccountsParams": {
      "type": "object",
      "properties": {}
    },
    "listAccountsResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "success"
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "maxMessageLength": {
                "type": "number"
              }
            },
            "required": [
              "name",
              "maxMessageLength"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "accounts"
      ],
      "additionalProperties": false
    },
    "createPostParams": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string",
          "minLength": 1
        },
        "replyToTweetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "text"
      ]
    },
    "createPostResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "success"
        },
        "account": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "account",
        "id",
        "url"
      ],
      "additionalProperties": false
    }
  },
  "x-tokenring-rpc": {
    "name": "X RPC",
    "path": "/rpc/x",
    "source": "plugin/x/rpc/schema.ts",
    "methods": {
      "listAccounts": {
        "type": "query",
        "params": "#/$defs/listAccountsParams",
        "result": "#/$defs/listAccountsResult"
      },
      "createPost": {
        "type": "mutation",
        "params": "#/$defs/createPostParams",
        "result": "#/$defs/createPostResult"
      }
    }
  }
}
