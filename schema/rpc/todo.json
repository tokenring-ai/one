{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Todo RPC",
  "description": "JSON-RPC 2.0 messages for /rpc/todo",
  "anyOf": [
    {
      "$ref": "#/$defs/JSONRPCError"
    },
    {
      "title": "getTodos request",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "method": {
          "const": "/rpc/todo.getTodos"
        },
        "params": {
          "$ref": "#/$defs/getTodosParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "title": "getTodos response",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "result": {
          "$ref": "#/$defs/getTodosResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "title": "streamTodos request",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "method": {
          "const": "/rpc/todo.streamTodos"
        },
        "params": {
          "$ref": "#/$defs/streamTodosParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "title": "streamTodos response",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "result": {
          "$ref": "#/$defs/streamTodosResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "title": "streamTodos stream end response",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "number"
        },
        "result": {
          "type": "null"
        },
        "stream": {
          "const": "end"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result",
        "stream"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "JSONRPCError": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "number",
            "null"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "number"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false
    },
    "getTodosParams": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string"
        }
      },
      "required": [
        "agentId"
      ]
    },
    "getTodosResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "success"
            },
            "todos": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "in_progress",
                      "completed"
                    ]
                  }
                },
                "required": [
                  "id",
                  "content",
                  "status"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "status",
            "todos"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "agentNotFound"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        }
      ]
    },
    "streamTodosParams": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string"
        }
      },
      "required": [
        "agentId"
      ]
    },
    "streamTodosResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "success"
            },
            "todos": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "in_progress",
                      "completed"
                    ]
                  }
                },
                "required": [
                  "id",
                  "content",
                  "status"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "status",
            "todos"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "agentNotFound"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "x-tokenring-rpc": {
    "name": "Todo RPC",
    "path": "/rpc/todo",
    "source": "plugin/todo/rpc/schema.ts",
    "methods": {
      "getTodos": {
        "type": "query",
        "params": "#/$defs/getTodosParams",
        "result": "#/$defs/getTodosResult"
      },
      "streamTodos": {
        "type": "stream",
        "params": "#/$defs/streamTodosParams",
        "result": "#/$defs/streamTodosResult"
      }
    }
  }
}
